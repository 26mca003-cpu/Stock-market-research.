# Caddyfile for VRIDDHI Production VM (TRD §14)
# Reverse proxy with automatic Let's Encrypt HTTPS

# Frontend Application
{$DOMAIN:vriddhi.app} {
    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Proxy to Next.js server
    reverse_proxy localhost:3000
}

# Backend API
api.{$DOMAIN:vriddhi.app} {
    encode gzip zstd

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Access-Control-Allow-Origin "https://{$DOMAIN:vriddhi.app}"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # Proxy to FastAPI / Uvicorn server
    reverse_proxy localhost:8000
}
